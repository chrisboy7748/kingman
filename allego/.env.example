# Base de données PostgreSQL (Supabase : utilisez l'URL du "connection pooler")
DATABASE_URL=postgres://allego:allego@localhost:5432/allego

# Secret de signature des sessions : chaîne aléatoire d'au moins 32 caractères
# (ex. : openssl rand -base64 32)
SESSION_SECRET=

# URL publique du site, sans "/" final
APP_URL=http://localhost:3000

# E-mails ayant accès à /admin, séparés par des virgules
ADMIN_EMAILS=

# PayPal — "sandbox" pour les tests, "live" pour les vrais paiements
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Renseignés par `npm run paypal:setup`
PAYPAL_PLAN_MONTHLY=
PAYPAL_PLAN_YEARLY=
# ID du webhook créé dans le tableau de bord développeur PayPal
PAYPAL_WEBHOOK_ID=
