# Base de données PostgreSQL (Supabase : utilisez l'URL du "connection pooler")
DATABASE_URL=postgres://allego:allego@localhost:5432/allego

# Secret de signature des sessions : chaîne aléatoire d'au moins 32 caractères
# (ex. : openssl rand -base64 32)
SESSION_SECRET=

# URL publique du site, sans "/" final. Facultatif sur Vercel : l'adresse de production
# est détectée automatiquement.
APP_URL=http://localhost:3000

# E-mails ayant accès à /admin, séparés par des virgules
ADMIN_EMAILS=

# PayPal — "sandbox" pour les tests, "live" pour les vrais paiements
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Renseignés par le bouton de la page Administration (ou `npm run paypal:setup`)
PAYPAL_PLAN_MONTHLY=
PAYPAL_PLAN_YEARLY=
PAYPAL_WEBHOOK_ID=

# E-mails (Resend) — sans clé, les e-mails sont seulement écrits dans les journaux du serveur
RESEND_API_KEY=
# Expéditeur. Sans domaine vérifié chez Resend, seule l'adresse de test fonctionne,
# et uniquement vers l'e-mail de votre compte Resend.
EMAIL_FROM=Allégo <onboarding@resend.dev>

# Protège la tâche quotidienne /api/cron/rappels (Vercel l'envoie automatiquement)
CRON_SECRET=
